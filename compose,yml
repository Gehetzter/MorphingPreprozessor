
services:
  body-morph:
    image: ghcr.io/gehetzter/body-morph:latest
    expose:
      - "8080"
    volumes:
      - ./data:/data
    environment:
      TARGET_HEIGHT: "1200"
      BACKGROUND_COLOR: "#D3D3D3"
      U2NET_HOME: /models
      PYTHONUNBUFFERED: "1"
    networks:
      - MorphingIsolated
    restart: unless-stopped

  nginx:
    image: nginx:alpine
    container_name: MorphingNginx
    ports:
      - "8083:8083"
    configs:
      - source: nginx_config
        target: /etc/nginx/nginx.conf
    networks:
      - default
      - MorphingIsolated
    restart: unless-stopped

networks:
  default:
    driver: bridge

  MorphingIsolated:
    external: true
    name: MorphingIsolated

configs:
  nginx_config:
    content: |
      events {}

      http {
        map $$http_upgrade $$connection_upgrade {
          default upgrade;
          '' close;
        }

        server {
          listen 8083;
          client_max_body_size 2000m;

          location / {
            proxy_pass http://body-morph:8080;
            proxy_http_version 1.1;

            proxy_set_header Upgrade $$http_upgrade;
            proxy_set_header Connection $$connection_upgrade;

            proxy_set_header Host $$host;
            proxy_set_header X-Real-IP $$remote_addr;
            proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $$scheme;

            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            proxy_buffering off;
          }
        }
      }
